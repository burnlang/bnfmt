def class Human {
    String name
    int age
    static fun create(name: string, age: int): Human {
        return Human {name: name, age: age}
    }

    fun greet(): string {
        return "Hello, " + name + "!"
    }
}

def class Dog {
    string name
    string breed
    fun bark(): string {
        return name + " says Woof!"
    }
}

fun main() {
    var john = Human.create("John", 30)
    print(john.greet())
    var rex = Dog {name: "Rex", breed: "Golden Retriever"}
    if (rex.breed != "Poodle") {print(rex.bark())}
    for i in 0..3 { print(i * 2, -i) }
}
